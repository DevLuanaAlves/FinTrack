<?xml version="1.0" encoding="UTF-8"?>
<project name="FinTrack" default="default" basedir=".">

    <description>Builds, tests, and runs the project FinTrack.</description>

    <import file="nbproject/build-impl.xml"/>

    <target name="test" depends="compile-test">

        <java
            classname="org.junit.platform.console.ConsoleLauncher"
            fork="true"
            failonerror="true">

            <classpath>
                <pathelement location="C:\Users\ADMIN\Downloads\junit-platform-console-standalone-1.10.3.jar"/>
                <pathelement location="C:\Users\ADMIN\Downloads\sqlite-jdbc-3.53.4.0.jar"/>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
            </classpath>

            <arg value="execute"/>

            <arg value="--class-path"/>
            <arg value="${build.classes.dir};${build.test.classes.dir}"/>

            <arg value="--scan-class-path"/>

        </java>

    </target>

</project>